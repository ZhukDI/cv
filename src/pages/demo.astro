---
import {DEMO_CV} from '../data/demo-cv';
import Layout from '../layouts/Layout.astro';
import Header from "../components/Header.astro";
import Summary from "../components/Summary.astro";
import WorkExperience from "../components/WorkExperience.astro";
import Education from "../components/Education.astro";
import Skills from "../components/Skills.astro";
import PrintInstruction from "../components/PrintInstruction.astro";
import demoAvatar from '../assets/avatar-demo.jpeg';

const {name, about} = DEMO_CV;
---
<Layout title={`${name} | CV`} description={about} image="/og-demo.png" cv={DEMO_CV} noindex={true}>
    <main class="container relative mx-auto scroll-my-12 overflow-auto p-4 print:p-11 md:p-16" id="main-content">
        <section class="mx-auto w-full max-w-2xl space-y-8 bg-background print:space-y-4" aria-label="CV Content">
            <Header cv={DEMO_CV} avatar={demoAvatar}/>
            <div class="space-y-8 print:space-y-4">
                <Summary cv={DEMO_CV}/>
                <WorkExperience cv={DEMO_CV}/>
                <Education cv={DEMO_CV}/>
                <Skills cv={DEMO_CV}/>
            </div>
        </section>
        <PrintInstruction/>
    </main>
</Layout>
